{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medusa",
  "version": "1.1.0",
  "identifier": "com.claudechat.app",
  "build": {
    "frontendDist": "../../client/dist",
    "beforeBuildCommand": "npm run build --prefix ../client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/medusa-server"
    ],
    "resources": [
      "resources/public"
    ],
    "macOS": {
      "entitlements": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
