{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medusa",
  "version": "1.1.0",
  "identifier": "com.claudechat.app",
  "build": {
    "frontendDist": "../../client/dist",
    "beforeBuildCommand": "npm run build --prefix ../client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/medusa-server",
      "binaries/medusa-mcp-shim"
    ],
    "resources": [
      "resources/public"
    ],
    "macOS": {
      "entitlements": "Medusa.entitlements"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://example.com/medusa-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY"
    }
  }
}
