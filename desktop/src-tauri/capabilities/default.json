{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Medusa window: core APIs plus permission to run the bundled medusa-server sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "medusa-server",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "medusa-server",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default"
  ]
}
